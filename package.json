{
  "name": "@engineereddev/rostra",
  "version": "0.1.0-beta.2",
  "description": "Durable evidence-backed deliberation and Decision CI MCP server",
  "keywords": [
    "decision-making",
    "deliberation",
    "mcp",
    "model-context-protocol"
  ],
  "homepage": "https://github.com/EngineeredDev/rostra#readme",
  "bugs": {
    "url": "https://github.com/EngineeredDev/rostra/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EngineeredDev/rostra.git"
  },
  "bin": {
    "rostra": "dist/cli/main.js",
    "rostra-supervisor": "dist/jobs/supervisor-main.js",
    "rostra-worker": "dist/jobs/worker-main.js"
  },
  "files": [
    "dist",
    "config.example.yaml",
    "server.json",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "prepack": "pnpm build",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "oxlint --tsconfig tsconfig.typecheck.json .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:package": "node scripts/smoke-package.mjs",
    "generate:schemas": "node dist/scripts/generate-schemas.js",
    "models:fetch": "node dist/cli/main.js models fetch"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "better-sqlite3": "12.4.1",
    "pino": "10.3.1",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.11.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "onnxruntime-node",
      "protobufjs",
      "sharp"
    ]
  },
  "mcpName": "io.github.engineereddev/rostra"
}
