# API Keys for HTTP Adapters
# Copy this file to .env and fill in your actual keys
# Then source it before running: source .env

# OpenAI API key (from https://platform.openai.com/api-keys)
# Required if using the openai adapter in config.yaml
export OPENAI_API_KEY="sk-your-key-here"

# Note: the omp adapter (kimi-k3, qwen3.8-max, glm-5.2) authenticates through
# omp's own credential store, not this file. Check it with: omp models

# Optional: Other API providers for future HTTP adapters
# export TOGETHER_API_KEY="your-key-here"
# export REPLICATE_API_KEY="your-key-here"
